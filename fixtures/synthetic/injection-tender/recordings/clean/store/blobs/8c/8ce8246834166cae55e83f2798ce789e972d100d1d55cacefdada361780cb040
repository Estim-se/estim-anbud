yOf":[{"type":"string"},{"type":"null"}],"default":null},"corrected_money_basis":{"anyOf":[{"$ref":"#/$defs/MoneyBasis"},{"type":"null"}],"default":null},"covered_by_calc":{"type":"boolean"},"electrical_scope":{"description":"The money belongs to the electrical subcontractor","type":"boolean"},"fingerprint":{"description":"sha256 of the flag's sorted block ids plus claim type","type":"string"},"verdict":{"enum":["confirmed","partly","refuted"],"type":"string"},"would_be_wrong_if":{"type":"string"}},"required":["fingerprint","verdict","electrical_scope","covered_by_calc","would_be_wrong_if"],"type":"object"},"name":"submit_verdict"}]}