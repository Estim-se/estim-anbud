# Secrets and local environments
.env*
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/

# Document files never belong here outside fixtures/synthetic/ (the CI guard enforces this too)
*.pdf
*.xlsx
*.xlsm
*.xls
*.xlsb
*.ods
*.docx
*.doc
*.odt
*.dwg
*.dxf
*.ifc
*.ifczip
*.png
*.jpg
*.jpeg
*.gif
*.tif
*.tiff
*.bmp
*.heic
*.heif
*.webp
*.svg
*.zip
*.7z
*.rar
*.msg
*.eml
!fixtures/synthetic/**
# ...but never secrets or caches, even there
fixtures/synthetic/**/.env*
fixtures/synthetic/**/__pycache__/
fixtures/synthetic/**/*.py[cod]
fixtures/synthetic/**/.venv/
fixtures/synthetic/**/.pytest_cache/
fixtures/synthetic/**/.ruff_cache/
fixtures/synthetic/**/.DS_Store
